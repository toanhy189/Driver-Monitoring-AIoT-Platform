{
  "title": "Driver platform operations",
  "uid": "driver-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Devices online",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "devices_online",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alerts recorded",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "alerts_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Commands recorded",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "commands_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "MQTT reconnects (process)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "mqtt_reconnect_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Command ACK p95 ms",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "command_ack_latency_ms{quantile=\"0.95\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "AI inference p95 ms",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "ai_inference_latency_ms{quantile=\"0.95\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "AI FPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "ai_fps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "AI memory bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "driver-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "ai_process_rss_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}