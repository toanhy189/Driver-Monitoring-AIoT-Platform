{
  "note": "Permission example only, no account passwords",
  "alert-EXAMPLE": [
    {
      "acltype": "publishClientSend",
      "topic": "driver/alert-EXAMPLE/telemetry",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "publishClientSend",
      "topic": "driver/alert-EXAMPLE/status",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "publishClientSend",
      "topic": "driver/alert-EXAMPLE/ack",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "publishClientSend",
      "topic": "driver/alert-EXAMPLE/heartbeat",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "publishClientSend",
      "topic": "driver/alert-EXAMPLE/config/applied",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "subscribeLiteral",
      "topic": "driver/alert-EXAMPLE/command",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "subscribeLiteral",
      "topic": "driver/alert-EXAMPLE/config/update",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "publishClientReceive",
      "topic": "driver/alert-EXAMPLE/command",
      "allow": true,
      "priority": 1
    },
    {
      "acltype": "publishClientReceive",
      "topic": "driver/alert-EXAMPLE/config/update",
      "allow": true,
      "priority": 1
    }
  ],
  "backend": {
    "read": [
      "driver/#"
    ],
    "write": [
      "driver/+/command",
      "driver/+/config/update"
    ]
  },
  "edge-ai": {
    "read": [],
    "write": [
      "driver/telemetry",
      "driver/events",
      "driver/status"
    ]
  }
}