PROJECT_NAME=Drowsiness Detection System
FASTAPI_ENV=development
API_STR=/api

POSTGRES_USER=postgres
POSTGRES_PASSWORD=MAT_KHAU_DB
POSTGRES_DB=device_monitor
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://postgres:MAT_KHAU_DB@localhost:5433/device_monitor

SECRET_KEY=your-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30

BACKEND_HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:5173

# Nếu truy cập giao diện từ máy khác trong mạng LAN, đổi thành địa chỉ IP của máy chạy frontend
# Ví dụ: FRONTEND_HOST=http://192.168.1.10:5173

# Khi chạy Backend ngoài Docker dùng localhost; trong Docker Compose hệ thống tự dùng tên service mosquitto
MQTT_HOST=localhost
# Broker trong Docker mở cổng 1884 ra máy host (bên trong mạng container vẫn dùng 1883)
MQTT_PORT=1884

# Chạy lệnh: python deployment/mqtt/prepare_env.py để sinh tự động mật khẩu vào file .env
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=
MQTT_USERNAME=backend
MQTT_PASSWORD=
AI_MQTT_USERNAME=vision-01
AI_MQTT_PASSWORD=
# Nếu chạy Edge AI trên máy khác trong LAN, điền IP của máy chạy MQTT broker
AI_MQTT_HOST=localhost
# AI_MQTT_PORT=1884
AI_DEVICE_CODE=vision-01
# AI_QUEUE_DB=C:/path/to/private/queue.db

# Tham số thời gian và giới hạn hàng đợi của Edge AI
AI_FACE_LOSS_RESET_SECONDS=1.0
AI_MAX_OBSERVATION_GAP_SECONDS=0.5
AI_LOCAL_ALERT_ENABLED=true
AI_LOCAL_ALERT_COOLDOWN_SECONDS=10
AI_VIDEO_UPLOAD_INTERVAL_SECONDS=5
AI_VIDEO_UPLOAD_MAX_RETRY_SECONDS=300
AI_VIDEO_MAX_CLIP_SECONDS=60
AI_VIDEO_MAX_CLIP_BYTES=33554432
AI_VIDEO_STORAGE_MAX_BYTES=1073741824
AI_QUEUE_MAX_ROWS=20000
AI_QUEUE_MAX_PAYLOAD_BYTES=67108864
# AI_RECORDING_DIR=D:/private-driver-recordings

# Cấu hình mô hình AI (mặc định dùng baseline khi chưa truyền tham số qua script khởi chạy)
# Khi chạy demo v2 qua ./edge-ai/run-multisignal-v2.ps1 -Demo, script sẽ tự gán các biến bên dưới
AI_MODEL_MODE=baseline
# AI_MODEL_MODE=multisignal
# AI_MULTISIGNAL_BUNDLE=D:/private/multisignal/selected
# AI_MULTISIGNAL_DEVICE=cpu
# AI_PROFILE_ID=operator-01-webcam-0
# AI_CAPTURE_CONDITION=glasses
# AI_CAMERA_INDEX=0
AI_HEAD_DOWN_RISK_ENABLED=false
AI_DEBUG_PREDICTIONS=false
AI_EYE_CLOSURE_GUARD_ENABLED=false
# AI_EYE_CLOSURE_CALIBRATION=D:/private/eye-calibration/report.json
# AI_MODEL_PATH=D:/path/to/ml-runs/uta-optimized-v2/selected.joblib

# Cấu hình Rule Engine, timeout lệnh điều khiển và giới hạn kết nối WebSocket ở Backend
RULE_ENGINE_ENABLED=false
COMMAND_TIMEOUT_SECONDS=30
SQL_ECHO=false
MAX_WS_TICKETS=10000
MAX_WS_CONNECTIONS=500
WS_TICKET_TTL_SECONDS=30

# Kho lưu trữ video sự kiện (Docker Compose lưu trong volume video_data)
# AI_VIDEO_DIR=D:/private-driver-videos
AI_VIDEO_MAX_BYTES=104857600
AI_VIDEO_TOTAL_MAX_BYTES=4294967296

# Dịch vụ đồng bộ thời gian NTP nội bộ trong mạng LAN
NTP_BIND_ADDRESS=0.0.0.0

# Chạy python deployment/prepare_final_env.py nếu dùng thêm cụm giám sát Prometheus / Grafana
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Cấu hình cập nhật Firmware từ xa (OTA) cho ESP32
OTA_ENABLED=false
OTA_PUBLIC_BASE_URL=
OTA_ALLOW_HTTP_FOR_LAN=false
OTA_HTTPS_PORT=9443
