PROJECT_NAME=Drowsiness Detection System
FASTAPI_ENV=development
API_STR=/api

POSTGRES_USER=postgres
POSTGRES_PASSWORD=MAT_KHAU_DB
POSTGRES_DB=device_monitor

DATABASE_URL=postgresql+psycopg://postgres:MAT_KHAU_DB@localhost:5432/device_monitor

SECRET_KEY=your-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30

BACKEND_HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:5173

# Khi chạy BE trong Docker Compose, đổi MQTT_HOST thành tên service broker.
MQTT_HOST=localhost
# Broker Docker mở cổng 1884 trên máy; các container dùng 1883.
MQTT_PORT=1884

# Chạy python deployment/mqtt/prepare_env.py để tạo giá trị thật trong .env.
# Không đưa mật khẩu thật vào Git.
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=
MQTT_USERNAME=backend
MQTT_PASSWORD=
AI_MQTT_USERNAME=vision-01
AI_MQTT_PASSWORD=
# Nếu Edge AI chạy trên máy khác, đặt IP của laptop chạy broker.
AI_MQTT_HOST=localhost
# Optional overrides when the camera has its own broker endpoint or test queue.
# AI_MQTT_PORT=1884
AI_DEVICE_CODE=vision-01
# AI_QUEUE_DB=C:/path/to/private/queue.db

# Backend week 3: sample rule policy must be agreed with TV1/TV3 before enabling.
RULE_ENGINE_ENABLED=false
COMMAND_TIMEOUT_SECONDS=30
SQL_ECHO=false
MAX_WS_TICKETS=10000
MAX_WS_CONNECTIONS=500
WS_TICKET_TTL_SECONDS=30
