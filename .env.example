PROJECT_NAME=Drowsiness Detection System
FASTAPI_ENV=development
API_STR=/api

POSTGRES_USER=postgres
POSTGRES_PASSWORD=MAT_KHAU_DB
POSTGRES_DB=device_monitor
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://postgres:MAT_KHAU_DB@localhost:5433/device_monitor

SECRET_KEY=your-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30

BACKEND_HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:5173

# Nếu muốn chạy frontend trên máy khác, đổi HOST thành IP của laptop chạy frontend.
# ví dụ: FRONTEND_HOST= http://xxx.xxx.x.xx:5173

# Khi chạy BE trong Docker Compose, đổi MQTT_HOST thành tên service broker.
MQTT_HOST=localhost
# Broker Docker mở cổng 1884 trên máy; các container dùng 1883.
MQTT_PORT=1884

# Chạy python deployment/mqtt/prepare_env.py để tạo giá trị thật trong .env.
# Không đưa mật khẩu thật vào Git.
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=
MQTT_USERNAME=backend
MQTT_PASSWORD=
AI_MQTT_USERNAME=vision-01
AI_MQTT_PASSWORD=
# Nếu Edge AI chạy trên máy khác, đặt IP của laptop chạy broker.
AI_MQTT_HOST=localhost
# Optional overrides when the camera has its own broker endpoint or test queue.
# AI_MQTT_PORT=1884
AI_DEVICE_CODE=vision-01
# AI_QUEUE_DB=C:/path/to/private/queue.db

# Edge AI runtime: proposed defaults; validate timings on the target camera.
AI_FACE_LOSS_RESET_SECONDS=1.0
AI_MAX_OBSERVATION_GAP_SECONDS=0.5
AI_LOCAL_ALERT_ENABLED=true
# Legacy notification calls only; versioned policy schedules its own escalation/repeats.
AI_LOCAL_ALERT_COOLDOWN_SECONDS=10
AI_VIDEO_UPLOAD_INTERVAL_SECONDS=5
AI_VIDEO_UPLOAD_MAX_RETRY_SECONDS=300
# Operational recording budgets, separate from the agreed warning thresholds.
AI_VIDEO_MAX_CLIP_SECONDS=60
AI_VIDEO_MAX_CLIP_BYTES=33554432
AI_VIDEO_STORAGE_MAX_BYTES=1073741824
AI_QUEUE_MAX_ROWS=20000
AI_QUEUE_MAX_PAYLOAD_BYTES=67108864
# AI_RECORDING_DIR=D:/private-driver-recordings

# Keep baseline until a real, evaluated model is available. Paths are local.
AI_MODEL_MODE=baseline
# Eye/mouth v2 demo: ./edge-ai/run-multisignal-v2.ps1 -Demo.
# AI_MODEL_MODE=multisignal
# AI_MULTISIGNAL_BUNDLE=D:/private/multisignal/candidate
# AI_MULTISIGNAL_DEVICE=cpu
# AI v2 private trial is launched explicitly with edge-ai/run-multisignal-v2.ps1.
# A closure profile must match the operator/setup label, camera and glasses condition.
# AI_PROFILE_ID=operator-01-webcam-0
# AI_CAPTURE_CONDITION=glasses
# V2: explicit no-glasses restores the uncalibrated EAR<0.20/1s demo branch;
# glasses still requires its matching accepted calibration. Trial launcher sets this per process.
# AI_CAMERA_INDEX=0
# Launcher enables sustained head-down >=12deg for 3s; direct main.py is opt-in.
AI_HEAD_DOWN_RISK_ENABLED=false
# Opt-in private diagnostic logs; does not change predictions or thresholds.
AI_DEBUG_PREDICTIONS=false
# Experimental measured eye closure >=1s, recovery >=1s; opt in after validation.
# Default guard EAR is 0.20; calibration affects the guard, not RF features/policy.
AI_EYE_CLOSURE_GUARD_ENABLED=false
# Optional local report that passed separate eye-open/closed validation; guard only.
# AI_EYE_CLOSURE_CALIBRATION=D:/private/eye-calibration/report.json
# AI_MODEL_PATH=D:/path/to/ml-runs/uta-optimized-v2/selected.joblib

# Backend week 3: sample rule policy must be agreed with TV1/TV3 before enabling.
RULE_ENGINE_ENABLED=false
COMMAND_TIMEOUT_SECONDS=30
SQL_ECHO=false
MAX_WS_TICKETS=10000
MAX_WS_CONNECTIONS=500
WS_TICKET_TTL_SECONDS=30

# Private AI video storage. Docker Compose uses its own persistent video_data volume.
# AI_VIDEO_DIR=D:/private-driver-videos
AI_VIDEO_MAX_BYTES=104857600
# Manual deletion only; warn at 80%, retain Edge uploads when the server is full.
AI_VIDEO_TOTAL_MAX_BYTES=4294967296
# LAN-only NTP on the demo laptop; restrict access to the trusted network.
NTP_BIND_ADDRESS=0.0.0.0
# Generate these with python deployment/prepare_final_env.py; never commit real values.
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
